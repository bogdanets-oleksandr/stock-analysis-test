<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression suit">
    <listeners>
        <listener class-name="com.epam.training.oleksandr_bogdanets.listeners.ScreenshotTaker"/>
    </listeners>
    <parameter name="browser" value="chrome"/>
    <parameter name="env" value="dev"/>

    <test name="Signup test">
        <classes>
            <class name="com.epam.training.oleksandr_bogdanets.SignUpTest"/>
        </classes>
    </test>

    <test name="Login test">
        <classes>
            <class name="com.epam.training.oleksandr_bogdanets.LoginTest"/>
        </classes>
    </test>

    <test name="Watchlist test">
        <classes>
            <class name="com.epam.training.oleksandr_bogdanets.WatchlistTest"/>
        </classes>
    </test>
</suite>